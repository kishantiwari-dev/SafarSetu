# Local development template. Spring Boot does not load this file automatically.
SPRING_PROFILES_ACTIVE=dev
DB_URL=jdbc:postgresql://localhost:5432/replace-with-database-name
DB_USERNAME=replace-with-local-role
DB_PASSWORD=replace-with-local-password
SERVER_PORT=8080
# Local development only; production profile forces schema validation.
DDL_AUTO=update
# Set true only when intentionally adding the insert-only simulated demo dataset.
SEED_DEMO_DATA=false
DB_CONNECTION_TIMEOUT_MS=5000
DB_VALIDATION_TIMEOUT_MS=3000
DB_POOL_MAX_SIZE=10
LOCATION_STALE_AFTER=PT15M
OCCUPANCY_STALE_AFTER=PT30M
CROWDING_MODERATE_PERCENT=40
CROWDING_HIGH_PERCENT=70
CROWDING_NEARLY_FULL_PERCENT=90
# Production only: comma-separated exact HTTP(S) origins.
CORS_ALLOWED_ORIGINS=